# OpenAI-compatible transcription endpoint. A host must supply valid audio containers,
# e.g. WAV, and explicitly grant microphone permissions.
CONTINUITY_ASR_ENDPOINT=https://YOUR-APPROVED-ENDPOINT/v1/audio/transcriptions
CONTINUITY_ASR_MODEL=YOUR-ASR-MODEL
# Use API_KEY_ENV to name the environment variable that holds the key, rather than
# writing the secret itself into a file.
CONTINUITY_ASR_API_KEY_ENV=CONTINUITY_ASR_API_KEY
CONTINUITY_ASR_TIMEOUT_S=30
CONTINUITY_ASR_LANGUAGE=zh

# Text-to-speech endpoint. The app must provide an AudioSink and audio player.
CONTINUITY_TTS_ENDPOINT=https://YOUR-APPROVED-ENDPOINT/v1/audio/speech
CONTINUITY_TTS_MODEL=YOUR-TTS-MODEL
CONTINUITY_TTS_API_KEY_ENV=CONTINUITY_TTS_API_KEY
CONTINUITY_TTS_TIMEOUT_S=30
CONTINUITY_TTS_VOICE=YOUR-VOICE
CONTINUITY_TTS_FORMAT=wav
